{
  "expo": {
    "name": "Yape Dashboard",
    "slug": "yape-dashboard",
    "version": "3.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "backgroundColor": "#0a0a1a"
    },
    "android": {
      "versionCode": 5,
      "package": "com.yape.dashboard",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a1a"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK",
        "FOREGROUND_SERVICE"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#7c3aed"
        }
      ],
      "./withNotificationService",
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "44fc55a5-cf96-4905-9e8e-c030d393ac41"
      }
    }
  }
}
